# LV Copytrader — environment file
#
# Copy to .env next to this file and fill it in:  cp .env.example .env
# Public copies must never commit .env; the owner-only private edition tracks its snapshot.
# Everything below is read by backend/app/config.py; the MT5_* values and SIDECAR_TOKEN are
# also handed to the mt5-sidecar container by docker-compose.yml.
#
# Every value here has a working default in config.py, so a line you delete falls back to it.
# The commented block at the bottom lists every tunable constant with its default; uncomment
# a line only to change it.

# Path of the .env file itself. Read from the process environment, never from this file.
# Set it only when the file does not sit next to the repo root (the container uses /app/.env).
#SP_ENV_FILE=/app/.env

# ---------------------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------------------

# Fernet key that encrypts every secret stored in the database. Leave it empty on the first
# start: the backend generates one, writes it back into .env and logs that it did so.
# Losing or changing it makes stored secrets undecryptable — they are then flagged
# needs_reentry in the UI and must be typed in again. Keep a backup.
SECRET_KEY=

# Shared secret for the MT5 sidecar's JSON-RPC endpoint, sent as the X-SP-Token header.
# CHANGE ME before the first run. The sidecar port is never published to the host, but this
# token is the only thing between the compose network and order_send.
SIDECAR_TOKEN=change-me

# ---------------------------------------------------------------------------------------
# MetaTrader 5 account — seeds the settings the operator can later change in the UI
# ---------------------------------------------------------------------------------------

# Broker server name exactly as MT5 spells it (for example, YourBroker-Demo).
MT5_SERVER=YourBroker-Demo

# MT5 account number. Numeric, no spaces.
MT5_LOGIN=0

# MT5 account password. Replace this placeholder with the real one; it is rendered into the
# terminal's ini inside the sidecar and is never logged or returned by any API endpoint.
MT5_PASSWORD=your-mt5-password

# Where the sidecar downloads the MT5 installer from. The generic MetaQuotes build often does
# not list Exness servers — if your server is missing, paste the broker-branded installer URL
# from your broker's Personal Area here; it is the same terminal with a bundled server list.
MT5_INSTALLER_URL=https://download.mql5.com/cdn/web/metaquotes.ltd/mt5/mt5setup.exe

# Base URL of the sidecar's RPC endpoint on the compose network. Change it only if you rename
# the service or move the sidecar off compose.
SIDECAR_URL=http://mt5-sidecar:18812

# ---------------------------------------------------------------------------------------
# Runtime paths and logging
# ---------------------------------------------------------------------------------------

# Directory for the SQLite database, downloaded signal images and Telethon session material.
# Mount it as a volume; deleting it loses the trade history and every stored credential.
DATA_DIR=/data

# Backend log verbosity: CRITICAL, ERROR, WARNING, INFO, DEBUG or NOTSET.
LOG_LEVEL=INFO

# Directory of the built frontend bundle that FastAPI serves as the dashboard.
FRONTEND_DIST=/app/static

# ---------------------------------------------------------------------------------------
# Tunable constants — defaults shown, uncomment a line to override it.
# dict and list values must be written as JSON when they come from the environment.
# ---------------------------------------------------------------------------------------

# Seconds a single RPC call to the MT5 sidecar may take before it counts as a transport failure.
#RPC_TIMEOUT_SECONDS=30.0
# Seconds allowed to open the connection to the sidecar.
#RPC_CONNECT_TIMEOUT_SECONDS=10.0
# Seconds between sidecar pings that drive the MT5 status dot.
#RPC_HEALTH_SECONDS=10.0

# Magic number stamped on every order this system sends. Positions with a different magic are
# shown read-only as external and are never modified or closed, including by the kill switch.
#MAGIC_NUMBER=770077
# Slippage tolerance in points on every market order and market close.
#DEVIATION_POINTS=20
# Re-quote retries after retcode 10004 or 10020 before the failure goes back to the model.
#REQUOTE_RETRIES=2

# Seconds the broker symbol list is cached before it is refreshed.
#SYMBOL_CACHE_SECONDS=3600
# Maximum ranked symbol candidates handed to the model, which always picks one itself.
#MAX_SYMBOL_CANDIDATES=8
# Per-symbol pip sizes overriding the automatic convention, as a JSON object.
#PIP_OVERRIDES={"XAUUSDm": 0.1}

# Percent of balance risked when the model gives neither volume nor risk_percent.
#DEFAULT_RISK_PERCENT=1.0
# Fraction of free margin one order may consume, checked with order_calc_margin first.
#MARGIN_HEADROOM=0.8
# Override the detected margin mode with hedging or netting; empty means detect it.
#FORCE_MARGIN_MODE=
# Maximum take-profit targets one signal is split across; extra targets are unmanaged.
#MAX_TP_SPLITS=3

# Seconds between sweeps for open positions of ours that have no stop loss.
#SL_WATCHDOG_SECONDS=60
# Watchdog cycles the AI is asked to fix a missing stop before the executor attaches one itself.
#SL_FALLBACK_ATTEMPTS=3
# Distance in points from entry for that fallback stop, or the broker minimum if larger.
#SL_FALLBACK_POINTS=500

# Depth of the per-source ingest queue; on overflow the oldest message is dropped with a warning.
#INGEST_QUEUE_MAX=50
# Messages fetched after a restart to cover the gap. The first run for a source fetches none.
#CATCHUP_LIMIT=20
# Telethon sleeps through flood waits shorter than this; longer ones surface on the dashboard.
# Telegram application credentials from my.telegram.org -> API development tools. They are
# issued ONCE per application and belong to the deployment, not to the account: connecting a
# different Telegram account later reuses the same pair. Leave them blank to enter them in
# the dashboard instead; whatever the database already holds always wins.
#TELEGRAM_API_ID=1234567
#TELEGRAM_API_HASH=
# Account phone in E.164 the login flow starts from, e.g. +14155552671.
#TELEGRAM_PHONE=
# An existing Telethon StringSession. Set it to bring a fresh clone up ALREADY SIGNED IN,
# skipping the login code entirely. Treat it like a password: it is full access to the
# account. Stored encrypted once seeded.
#TELEGRAM_SESSION=

#TELEGRAM_FLOOD_SLEEP_THRESHOLD=60

# How many ingest workers may run triage + the full agent at once (1–3). Broker writes stay serial.
#INGEST_WORKERS=3

# Tool-calling turns allowed in one full agent run before a final tool-less turn is forced.
# Raised so a ladder is not cut off. Do not lower this to buy speed; triage is a separate call.
#MAX_TOOL_ITERATIONS=32
# max_tokens on every full-agent provider request. Anthropic requires the field. High so
# thinking models are not truncated. provider.max_tokens in Settings overrides this.
# The yes/no triage call does not use this budget (TRIAGE_MAX_TOKENS, default 256).
#MAX_TOKENS=32768
#TRIAGE_MAX_TOKENS=256
# Maximum images attached to one run's context; truncation is stated in the context.
#MAX_IMAGES_PER_RUN=4
# Age in seconds at which a signal is flagged stale to the model.
#STALE_SIGNAL_SECONDS=600
# Recent messages from the active source included in every run's context.
#CONTEXT_SIGNALS=10
# Upper bound on rows the get_recent_signals tool may return.
#RECENT_SIGNALS_TOOL_MAX=25

# Longest image edge in pixels before sending; lower it to cut token cost.
#IMAGE_MAX_EDGE=1568
# JPEG quality images are first re-encoded at.
#IMAGE_JPEG_QUALITY=85
# Lowest JPEG quality the re-encode loop drops to while fitting the byte cap.
#IMAGE_MIN_QUALITY=40
# Maximum encoded size of one image in bytes.
#IMAGE_MAX_BYTES=3500000

# Hours a model's probed vision and tool capabilities stay cached.
#PROBE_CACHE_HOURS=24
# Timeout in seconds for a streaming provider request.
#PROVIDER_TIMEOUT_SECONDS=180.0

# Retry delays in seconds for a failed Telegram notification, as a JSON list.
#NOTIFY_RETRY_DELAYS=[1.0, 4.0]
# Seconds getUpdates is polled while detecting the operator's chat id.
#NOTIFY_DETECT_SECONDS=60
# Seconds between those getUpdates polls.
#NOTIFY_POLL_SECONDS=2.0

# Seconds between account snapshots pushed to the dashboard as account.tick events.
#ACCOUNT_TICK_SECONDS=3.0
# Event queue depth per WebSocket client; the oldest event is dropped when a slow client fills it.
#EVENT_QUEUE_MAX=500
# Maximum OHLC bars the get_candles tool returns in one call.
#MAX_CANDLES=200
# Echo every SQL statement to the log. Debugging only.
#DB_ECHO=false

# Dashboard login. Leave BOTH empty to disable authentication (localhost only).
# Set them before exposing the app through a tunnel, a proxy or a forwarded port: the
# dashboard carries the ARM switch, the kill switch and manual order entry.
SP_AUTH_USER=operator
SP_AUTH_PASSWORD=change-me-to-a-long-passphrase

# Immediate reverse-proxy IPs only; include loopback for local administration.
# Update this if the Cloudflare tunnel container changes its network address.
SP_TRUSTED_PROXY_IPS=127.0.0.1
